# Local development values only. Never commit real credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Reserved for explicitly authorized server-only operations; never use in browser modules.
SUPABASE_SERVICE_ROLE_KEY=
# Clerk authentication (publishable key is public; secret key is server-only).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Development Paystack test credentials only until the payment workstream is approved.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
